{
  "name": "soop-unified-core",
  "version": "2.6.0",
  "private": true,
  "description": "Accuracy-first unofficial SOOP unified realtime core with strict wire normalization, broadcast identity generations, upstream-family evidence consensus, temporal skew scoring, adaptive handshake fallback, protocol drift diagnostics and operator Studio.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "verify:repo": "node scripts/verify-repository.mjs",
    "build": "npm run verify:repo && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run verify:repo && tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:compiled": "node --test dist/tests/*.test.js",
    "soak": "tsx scripts/soak.ts",
    "desktop": "npm run build && electron .",
    "build:windows": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "optionalDependencies": {
    "soop-extension": "1.3.3",
    "soop.js": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "electron": "38.1.0",
    "electron-builder": "26.0.12"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "live.soop.starbox",
    "productName": "별상자 스튜디오",
    "artifactName": "StarBox-Studio-Portable-${version}.${ext}",
    "files": ["desktop/**/*", "dist/**/*", "package.json", "node_modules/ws/**/*"],
    "directories": {"output": "release"},
    "win": {"target": "portable"}
  }
}
