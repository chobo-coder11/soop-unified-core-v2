{
  "name": "soop-unified-core",
  "version": "2.3.0",
  "private": true,
  "description": "Hardened fault-tolerant unified unofficial SOOP API core with adaptive consensus, occurrence-safe realtime deduplication, protocol drift flight recording, secure transport, and multi-provider validation/fallback.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "verify:repo": "node scripts/verify-repository.mjs",
    "build": "npm run verify:repo && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run verify:repo && tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:compiled": "node --test dist/tests/*.test.js",
    "soak": "tsx scripts/soak.ts"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "optionalDependencies": {
    "soop-extension": "1.3.3",
    "soop.js": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
