PORT=8080
HOST=0.0.0.0
SOOP_API_KEY=
SOOP_RATE_LIMIT_PER_MINUTE=240
SOOP_STREAM_IDLE_TTL_MS=30000
SOOP_RAW_BUFFER_PER_STREAM=1000
SOOP_EVENT_DEDUP_TTL_MS=2500
SOOP_PROVIDER_TIMEOUT_MS=4500
SOOP_JAVA_SIDECAR_URL=http://java-sidecar:8091
SOOP_ENABLE_JAVA_SIDECAR=true
SOOP_ENABLE_REINDEER_PROVIDER=true
SOOP_ENABLE_REINDEER_EVENTS=false
SOOP_ENABLE_SOOPJS_PROVIDER=false
SOOP_MAX_WS_SUBSCRIPTIONS=100
SOOP_MAX_WS_CLIENTS=500
SOOP_WS_CLIENT_IDLE_MS=90000
SOOP_WS_MAX_PAYLOAD_BYTES=65536
SOOP_WS_BACKPRESSURE_BYTES=2000000
SOOP_WS_REPLAY_EVENTS=5000
SOOP_CONNECTION_TIMELINE_LIMIT=100

# Query coalescing / cache
SOOP_LIVE_CACHE_MS=1200
SOOP_CHANNEL_CACHE_MS=15000
SOOP_BATCH_CONCURRENCY=8

# Authenticated write API (chat/whisper) - intentionally OFF by default.
# When enabling, set SOOP_API_KEY too. Passwords are never persisted. Bearer session tokens are hash-only at rest; SOOP cookies stay in memory.
SOOP_ENABLE_WRITE_API=false
SOOP_AUTH_SESSION_TTL_MS=28800000
SOOP_MAX_BODY_BYTES=65536

# v2.4 realtime safety / recovery
# TLS verification is ON by default. Set true only for controlled debugging.
SOOP_ALLOW_INSECURE_TLS=false
SOOP_CHAT_PING_INTERVAL_MS=30000
SOOP_CHAT_LIVENESS_TIMEOUT_MS=120000
SOOP_CHAT_JOIN_TIMEOUT_MS=12000
SOOP_CHAT_OFFLINE_POLL_MS=30000
SOOP_CHAT_MAX_BACKOFF_MS=30000
SOOP_CACHE_STALE_IF_ERROR_MS=15000

# Protocol drift detector
SOOP_DRIFT_WINDOW_MS=60000
SOOP_DRIFT_MIN_UNKNOWN=20
SOOP_DRIFT_MIN_MALFORMED=5
SOOP_DRIFT_MIN_STREAMS=3
SOOP_DRIFT_UNKNOWN_RATIO=0.08
SOOP_DRIFT_ALERT_COOLDOWN_MS=30000
